generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== CLIENTES ====================

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  tenantId  String   @default("sendero3d") @map("tenant_id")
  creadoEn  DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("updated_at")

  pedidos Pedido[]

  @@map("clientes")
}

// ==================== CATEGORÍAS ====================

model Categoria {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  color       String?
  activo      Boolean  @default(true)
  tenantId    String   @default("sendero3d") @map("tenant_id")
  creadoEn    DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modelos CategoriaModelo[]

  @@map("categorias")
}

model CategoriaModelo {
  id          String @id @default(cuid())
  categoriaId String @map("categoria_id")
  modeloId    String @map("modelo_id")

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  modelo    Modelo    @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, modeloId])
  @@map("categorias_modelos")
}

// ==================== MODELOS ====================

model Modelo {
  id                String   @id @default(cuid())
  nombre            String
  serie             String?
  pesoGr            Float?   @map("peso_gr")
  costoFab          Float    @default(0) @map("costo_fab")
  precioVenta       Float    @default(0) @map("precio_venta")
  precioCreditoPorc Float    @default(10) @map("precio_credito_porc")
  precioMayorista   Float?   @map("precio_mayorista")
  precioPromo       Float?   @map("precio_promo")
  notas             String?
  archivo3mfUrl     String?  @map("archivo_3mf_url")
  imagenUrl         String?  @map("imagen_url")
  imagenesUrls      String[] @default([]) @map("imagenes_urls")
  activo            Boolean  @default(true)
  tenantId          String   @default("sendero3d") @map("tenant_id")
  creadoEn          DateTime @default(now()) @map("creado_en")
  updatedAt         DateTime @updatedAt @map("updated_at")

  categorias  CategoriaModelo[]
  variantes   VarianteModelo[]
  itemsPedido ItemPedido[]

  @@map("modelos")
}

// ==================== VARIANTES DE MODELO ====================

model VarianteModelo {
  id              String  @id @default(cuid())
  modeloId        String  @map("modelo_id")
  nombre          String
  precioAdicional Float   @default(0) @map("precio_adicional")
  notas           String?
  activo          Boolean @default(true)

  modelo Modelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@map("variantes_modelo")
}

// ==================== PEDIDOS ====================

enum EstadoPedido {
  PENDIENTE_PAGO
  CONFIRMADO
  EN_PRODUCCION
  TERMINADO
  ENTREGADO
  ESPERANDO_LIQUIDACION_ML
  COMPLETADO
  CANCELADO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model Pedido {
  id                  String       @id @default(cuid())
  prioridad           Prioridad    @default(MEDIA)
  clienteId           String?      @map("cliente_id")
  fechaPedido         DateTime     @default(now()) @map("fecha_pedido")
  fechaEntrega        DateTime?    @map("fecha_entrega")
  estado              EstadoPedido @default(PENDIENTE_PAGO)
  metodoEnvio         String?      @map("metodo_envio")
  metodoPago          String?      @map("metodo_pago")
  precioEnvio         Float        @default(0) @map("precio_envio")
  senia               Float        @default(0)
  comprobanteUrl      String?      @map("comprobante_url")
  fechaLiquidacionMl  DateTime?    @map("fecha_liquidacion_ml")
  idMercadolibre      String?      @map("id_mercadolibre")
  contacto            String?
  notas               String?
  etiquetas           String[]     @default([])
  canalVenta          String       @default("directa") @map("canal_venta")
  tenantId            String       @default("sendero3d") @map("tenant_id")
  creadoEn            DateTime     @default(now()) @map("creado_en")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  items   ItemPedido[]

  @@map("pedidos")
}

// ==================== ITEMS DEL PEDIDO ====================

model ItemPedido {
  id              String  @id @default(cuid())
  pedidoId        String  @map("pedido_id")
  modeloId        String  @map("modelo_id")
  cantidad        Int     @default(1)
  precioUnitario  Float   @map("precio_unitario")
  costoUnitario   Float   @map("costo_unitario")
  ajusteManual    Float   @default(0) @map("ajuste_manual")
  variantesInfo   Json?   @map("variantes_info")

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  modelo   Modelo    @relation(fields: [modeloId], references: [id])

  @@map("items_pedido")
}

// ==================== FILAMENTOS ====================

model Filamento {
  id             String   @id @default(cuid())
  marca          String
  tipoMaterial   String   @map("tipo_material")
  color          String
  tempExtrusor   Int?     @map("temp_extrusor")
  tempCama       Int?     @map("temp_cama")
  velocidadRec   Int?     @map("velocidad_rec")
  pesoCarreteGr  Float?   @map("peso_carrete_gr")
  pesoRestanteGr Float?   @map("peso_restante_gr")
  costoPorGr     Float?   @map("costo_por_gr")
  notas          String?
  tenantId       String   @default("sendero3d") @map("tenant_id")
  creadoEn       DateTime @default(now()) @map("creado_en")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("filamentos")
}

// ==================== GASTOS ====================

model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  categoria   String
  monto       Float
  descripcion String?
  tenantId    String   @default("sendero3d") @map("tenant_id")
  creadoEn    DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("gastos")
}