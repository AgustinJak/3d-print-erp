generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== PERFILES (auth) ====================

model Perfil {
  id        String   @id
  userId    String   @unique @map("user_id")
  nombre    String?
  email     String?
  tenantId  String   @map("tenant_id")
  rol       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("perfiles")
}

// ==================== CLIENTES ====================

model Cliente {
  id          String   @id @default(cuid())
  nombre      String
  telefono    String?
  email       String?
  direccion   String?
  notas       String?
  plataforma  String?
  tipoCliente String?  @map("tipo_cliente")
  tenantId    String   @default("sendero3d") @map("tenant_id")
  creadoEn    DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pedidos Pedido[]

  @@map("clientes")
}

// ==================== CATEGORÍAS ====================

model Categoria {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  color       String?
  activo      Boolean  @default(true)
  tenantId    String   @default("sendero3d") @map("tenant_id")
  creadoEn    DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modelos CategoriaModelo[]

  @@map("categorias")
}

model CategoriaModelo {
  id          String @id @default(cuid())
  categoriaId String @map("categoria_id")
  modeloId    String @map("modelo_id")

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  modelo    Modelo    @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, modeloId])
  @@map("categorias_modelos")
}

// ==================== MODELOS ====================

model Modelo {
  id                String   @id @default(cuid())
  nombre            String
  sku               String?
  serie             String?
  pesoGr            Float?   @map("peso_gr")
  costoFab          Float    @default(0) @map("costo_fab") // imprimir la pieza
  costoInsumos      Float    @default(0) @map("costo_insumos") // lo que se le agrega después
  precioVenta       Float    @default(0) @map("precio_venta")
  precioCreditoPorc Float    @default(10) @map("precio_credito_porc")
  precioMayorista   Float?   @map("precio_mayorista")
  precioPromo       Float?   @map("precio_promo")
  notas             String?
  archivo3mfUrl     String?  @map("archivo_3mf_url")
  imagenUrl         String?  @map("imagen_url")
  imagenesUrls      String[] @default([]) @map("imagenes_urls")
  activo            Boolean  @default(true)
  consolidadoEnId   String?  @map("consolidado_en_id")
  /// Una pieza que no se vende sola y que consumen las recetas (las fundas). docs/sdd/004, spec 006.
  esInsumo          Boolean  @default(false) @map("es_insumo")
  /// Política de precio propia (docs/sdd/006, spec 002). null = la general de config_precios.
  margen            Float?
  promoMl           Float?   @map("promo_ml")
  redondeo          String?
  /// Lo que se publica en ML en la opción 1, fijado a mano (spec 002). null = el de la fórmula.
  precioMlFijo      Float?   @map("precio_ml_fijo")
  /// La categoría de ML para la comisión (spec 004) y de dónde salió: publicacion · heredada · predicha · manual.
  categoriaMl       String?  @map("categoria_ml")
  categoriaMlOrigen String?  @map("categoria_ml_origen")
  tenantId          String   @default("sendero3d") @map("tenant_id")
  creadoEn          DateTime @default(now()) @map("creado_en")
  updatedAt         DateTime @updatedAt @map("updated_at")

  categorias           CategoriaModelo[]
  variantes            VarianteModelo[]
  itemsPedido          ItemPedido[]
  sugerenciasTendencia SugerenciaProducto[]

  consolidadoEn   Modelo?         @relation("Consolidacion", fields: [consolidadoEnId], references: [id], onDelete: SetNull)
  consolidaciones Modelo[]        @relation("Consolidacion")
  publicacionesMl PublicacionMl[]
  stock           Stock[]
  reglasInsumo    ReglaInsumo[]
  combinaciones   Combinacion[]

  @@unique([tenantId, sku])
  @@map("modelos")
}

// ==================== VARIANTES DE MODELO ====================

model VarianteModelo {
  id                    String  @id @default(cuid())
  modeloId              String  @map("modelo_id")
  nombre                String
  precioAdicional       Float   @default(0) @map("precio_adicional")
  costoFabAdicional     Float   @default(0) @map("costo_fab_adicional")
  costoInsumosAdicional Float   @default(0) @map("costo_insumos_adicional")
  notas                 String?
  activo                Boolean @default(true)
  afectaStock           Boolean @default(false) @map("afecta_stock") // ¿define una pieza física distinta? (95cm sí, Con Funda no)
  /// "Color", "Funda", "Diseño": a qué elección pertenece (docs/sdd/004, spec 003).
  grupo                 String?
  /// pieza | insumo | decoracion. pieza ⇔ afectaStock (la base lo exige una vez rellenado).
  tipo                  String?

  modelo Modelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@map("variantes_modelo")
}

// ==================== PEDIDOS ====================

enum EstadoPedido {
  PENDIENTE_PAGO
  CONFIRMADO
  EN_PRODUCCION
  TERMINADO
  ENTREGADO
  ESPERANDO_LIQUIDACION_ML
  COMPLETADO
  CANCELADO
  RECLAMO_ABIERTO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model Pedido {
  id                 String       @id @default(cuid())
  prioridad          Prioridad    @default(MEDIA)
  clienteId          String?      @map("cliente_id")
  fechaPedido        DateTime     @default(now()) @map("fecha_pedido")
  fechaEntrega       DateTime?    @map("fecha_entrega")
  estado             EstadoPedido @default(PENDIENTE_PAGO)
  metodoEnvio        String?      @map("metodo_envio")
  metodoPago         String?      @map("metodo_pago")
  precioEnvio        Float        @default(0) @map("precio_envio")
  senia              Float        @default(0)
  comprobanteUrl     String?      @map("comprobante_url")
  fechaLiquidacionMl DateTime?    @map("fecha_liquidacion_ml")
  idMercadolibre     String?      @map("id_mercadolibre")
  contacto           String?
  notas              String?
  etiquetas          String[]     @default([])
  canalVenta         String       @default("directa") @map("canal_venta")
  ordenProduccion    Int?         @map("orden_produccion")
  origenExterno      Json?        @map("origen_externo")
  externoId          String?      @map("externo_id")
  tenantId           String       @default("sendero3d") @map("tenant_id")
  creadoEn           DateTime     @default(now()) @map("creado_en")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  cliente  Cliente?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  items    ItemPedido[]
  reservas ReservaStock[]

  @@unique([tenantId, externoId])
  @@map("pedidos")
}

// ==================== ITEMS DEL PEDIDO ====================

model ItemPedido {
  id             String  @id @default(cuid())
  pedidoId       String  @map("pedido_id")
  /// null = trabajo a medida que no es del catálogo: no reserva ni descuenta stock.
  modeloId       String? @map("modelo_id")
  /// Qué es la pieza cuando no hay modelo (lo que pidió el cliente).
  descripcion    String?
  cantidad       Int     @default(1)
  precioUnitario Float   @map("precio_unitario")
  costoUnitario  Float   @map("costo_unitario")
  ajusteManual   Float   @default(0) @map("ajuste_manual")
  variantesInfo  Json?   @map("variantes_info")
  mlaOrigen      String? @map("mla_origen") // publicación de ML que originó el item

  /// Qué se vendió (docs/sdd/001). null = línea vieja sin resolver, a medida o sin mapear.
  combinacionId String? @map("combinacion_id")
  /// Con qué clave entró del canal, para completarla cuando se mapea esa clave.
  claveCanal    String? @map("clave_canal")

  pedido      Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  modelo      Modelo?        @relation(fields: [modeloId], references: [id])
  combinacion Combinacion?   @relation(fields: [combinacionId], references: [id], onDelete: SetNull)
  reservas    ReservaStock[]

  @@map("items_pedido")
}

// ==================== FILAMENTOS ====================

model Filamento {
  id             String   @id @default(cuid())
  marca          String
  tipoMaterial   String   @map("tipo_material")
  color          String
  tempExtrusor   Int?     @map("temp_extrusor")
  tempCama       Int?     @map("temp_cama")
  velocidadRec   Int?     @map("velocidad_rec")
  pesoCarreteGr  Float?   @map("peso_carrete_gr")
  pesoRestanteGr Float?   @map("peso_restante_gr")
  costoPorGr     Float?   @map("costo_por_gr")
  notas          String?
  tenantId       String   @default("sendero3d") @map("tenant_id")
  creadoEn       DateTime @default(now()) @map("creado_en")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("filamentos")
}

// ==================== CONFIGURACIÓN DEL TENANT ====================

model ConfigTenant {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  data     Json   @default("{}")

  @@map("config_tenant")
}

// ==================== RADAR DE TENDENCIAS ====================

model EventoTendencia {
  id          String    @id @default(cuid())
  tenantId    String    @default("sendero3d") @map("tenant_id")
  titulo      String
  tipo        String // pelicula, serie, anime, concierto, fecha_comercial, gaming, evento
  fecha       DateTime
  fechaFin    DateTime? @map("fecha_fin")
  descripcion String?
  imagenUrl   String?   @map("imagen_url")
  nivelViral  String    @default("medio") // bajo, medio, alto, explosivo
  fuente      String    @default("manual") // tmdb, anilist, manual
  fuenteId    String?   @map("fuente_id") // ID externo (ej: TMDB movie ID)
  activo      Boolean   @default(true)
  creadoEn    DateTime  @default(now()) @map("creado_en")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sugerencias SugerenciaProducto[]

  @@unique([tenantId, fuente, fuenteId])
  @@map("eventos_tendencia")
}

model SugerenciaProducto {
  id                String  @id @default(cuid())
  eventoId          String  @map("evento_id")
  nombre            String
  descripcion       String?
  tipoProducto      String  @default("replica") @map("tipo_producto") // replica, accesorio, decoracion, funcional, soporte, llavero
  dificultad        String  @default("media") // baja, media, alta
  potencialVenta    Int     @default(2) @map("potencial_venta") // 1-3
  ventanaInicio     String? @map("ventana_inicio") // "2 semanas antes"
  imagenRef         String? @map("imagen_ref")
  modeloVinculadoId String? @map("modelo_vinculado_id")

  evento          EventoTendencia @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  modeloVinculado Modelo?         @relation(fields: [modeloVinculadoId], references: [id], onDelete: SetNull)

  @@map("sugerencias_producto")
}

// ==================== GASTOS ====================

model Gasto {
  id            String   @id @default(cuid())
  fecha         DateTime @default(now())
  categoria     String
  monto         Float
  descripcion   String?
  billetera     String   @default("fabricacion") // "fabricacion" | "empresarial"
  grupoCuotasId String?  @map("grupo_cuotas_id") // UUID común para cuotas del mismo gasto
  cuotaNumero   Int?     @map("cuota_numero") // 1, 2, 3...
  cuotaTotal    Int?     @map("cuota_total") // N total de cuotas
  tenantId      String   @default("sendero3d") @map("tenant_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([tenantId, billetera, fecha])
  @@index([tenantId, grupoCuotasId])
  @@map("gastos")
}

// ==================== TRANSFERENCIAS ENTRE BILLETERAS ====================

model Transferencia {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  monto       Float
  desde       String // "fabricacion" | "empresarial" | "externo"
  hacia       String // "fabricacion" | "empresarial" | "externo"
  descripcion String?
  tenantId    String   @default("sendero3d") @map("tenant_id")
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@index([tenantId, fecha])
  @@map("transferencias")
}

// ==================== INTEGRACIÓN / WEBHOOKS ====================

model WebhookLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  origen     String // ej: "shop"
  evento     String // ej: "pedido.confirmado"
  externoId  String?  @map("externo_id") // ej: "SS-00001"
  estado     String // "ok", "error", "ignorado"
  errorMsg   String?  @map("error_msg")
  pedidoId   String?  @map("pedido_id") // pedido creado/relacionado
  payload    Json
  ipAddress  String?  @map("ip_address")
  recibidoEn DateTime @default(now()) @map("recibido_en")

  @@index([tenantId, recibidoEn])
  @@index([tenantId, externoId])
  @@map("webhook_logs")
}

// ==================== CUENTAS MERCADO LIBRE (OAuth) ====================

model CuentaMercadolibre {
  id           String   @id @default(cuid())
  tenantId     String   @unique @map("tenant_id")
  mlUserId     String   @map("ml_user_id") // user_id de la cuenta ML
  nickname     String? // apodo de la cuenta (para mostrar en UI)
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at") // cuándo expira el access_token
  scope        String?
  creadoEn     DateTime @default(now()) @map("creado_en")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("cuentas_ml")
}

// ==================== MAPEO PUBLICACIONES ML → MODELO ====================

model PublicacionMl {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  mla                 String // ID de publicación ML (MLA...)
  modeloId            String?  @map("modelo_id") // modelo asociado (null = sin mapear)
  ignorar             Boolean  @default(false) // true = no es de este negocio (ej: juguete)
  titulo              String? // título de la publicación (cache)
  ultimoMla           String?  @map("ultimo_pedido") // último order_id donde apareció
  vecesVista          Int      @default(1) @map("veces_vista")
  variantesImplicitas String[] @default([]) @map("variantes_implicitas") // variantes que la publicación lleva SIEMPRE (95cm, Con Funda...)
  creadoEn            DateTime @default(now()) @map("creado_en")
  updatedAt           DateTime @updatedAt @map("updated_at")

  modelo Modelo? @relation(fields: [modeloId], references: [id], onDelete: SetNull)

  @@unique([tenantId, mla])
  @@index([tenantId, modeloId])
  @@map("publicaciones_ml")
}

// ==================== CASA (finanzas del hogar, personal) ====================

model CasaIngreso {
  id        String   @id @default(cuid())
  tenantId  String   @default("sendero3d") @map("tenant_id")
  persona   String // "tai" | "sendero"
  monto     Float    @default(0)
  mes       Int
  anio      Int
  creadoEn  DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, persona, mes, anio])
  @@map("casa_ingresos")
}

model CasaFijo {
  id          String   @id @default(cuid())
  tenantId    String   @default("sendero3d") @map("tenant_id")
  nombre      String
  monto       Float    @default(0)
  reparto     String   @default("proporcional") // "proporcional" | "mitad" | "personal"
  personaPaga String?  @map("persona_paga") // "tai"|"sendero" si reparto="personal"
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  creadoEn    DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("casa_fijos")
}

model CasaGasto {
  id          String   @id @default(cuid())
  tenantId    String   @default("sendero3d") @map("tenant_id")
  grupo       String // "fijo" | "ocio" | "inversion"
  nombre      String
  monto       Float    @default(0)
  reparto     String   @default("proporcional")
  personaPaga String?  @map("persona_paga")
  mes         Int
  anio        Int
  fijoId      String?  @map("fijo_id") // si se generó desde la plantilla
  fecha       DateTime @default(now())
  creadoEn    DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, anio, mes])
  @@map("casa_gastos")
}

/// Unidad de stock: un modelo + las variantes que definen una pieza física
/// distinta (`afectaStock`). "Bola de JOJOS · Verde Metalizado" y
/// "Tanjiro Katana · 95cm" son filas separadas; la funda NO abre una fila
/// porque no limita la venta.
model Stock {
  id            String   @id @default(cuid())
  tenantId      String   @default("sendero3d") @map("tenant_id")
  modeloId      String   @map("modelo_id")
  variantes     String[] @default([]) // ids de VarianteModelo con afectaStock
  clave         String // "<modeloId>|<varId,varId>" ordenado
  etiqueta      String? // legible: "Tanjiro Katana · 95cm"
  cantidad      Int      @default(0) // lo que hay hoy
  minimo        Int      @default(0) // colchón: por debajo, hay que reponer
  bodegaModelId String?  @map("bodega_model_id") // pieza de bodega.models que suma acá al producirse
  creadoEn      DateTime @default(now()) @map("creado_en")
  updatedAt     DateTime @updatedAt @map("updated_at")

  modelo       Modelo               @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  movimientos  MovimientoStock[]
  reservas     ReservaStock[]
  reglasInsumo ReglaInsumo[]
  pendiente    ProduccionPendiente?

  @@unique([tenantId, clave])
  @@index([tenantId, modeloId])
  @@map("stock")
}

/// Historial de todo lo que entra y sale del stock. Sin esto no hay forma de
/// auditar por qué una cantidad quedó donde quedó.
model MovimientoStock {
  id       String   @id @default(cuid())
  stockId  String   @map("stock_id")
  delta    Int // + producción / − venta
  motivo   String // "venta" | "produccion" | "ajuste"
  pedidoId String?  @map("pedido_id")
  nota     String?
  creadoEn DateTime @default(now()) @map("creado_en")

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, creadoEn])
  @@map("movimientos_stock")
}

/// Reserva de stock para un pedido.
///
/// Mientras está `RESERVADA` la pieza sigue en el galpón pero ya tiene dueño:
/// no se le puede prometer a otro pedido. `Stock.cantidad` NO baja todavía —
/// lo que baja es el disponible (`cantidad - reservado`). Cuando el pedido sale
/// la reserva pasa a `CONSUMIDA` y recién ahí se descuenta la cantidad física.
///
/// Las `RESERVADA` son efímeras: `reasignarReservas()` las borra y las vuelve a
/// calcular enteras cada vez que algo cambia, así nunca quedan a la deriva.
/// Las `CONSUMIDA` son historia y no se recalculan.
model ReservaStock {
  id          String    @id @default(cuid())
  tenantId    String    @default("sendero3d") @map("tenant_id")
  stockId     String    @map("stock_id")
  pedidoId    String    @map("pedido_id")
  itemId      String?   @map("item_id")
  cantidad    Int
  estado      String    @default("RESERVADA") // RESERVADA | CONSUMIDA
  tipo        String    @default("producto") // producto | insumo (funda)
  creadoEn    DateTime  @default(now()) @map("creado_en")
  consumidaEn DateTime? @map("consumida_en")

  stock  Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)
  pedido Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  item   ItemPedido? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, estado])
  @@index([pedidoId])
  @@index([stockId, estado])
  @@map("reservas_stock")
}

/// Lo que hay que imprimir porque hay pedidos esperándolo, por unidad de stock.
///
/// Es una **foto** que deja el reparto de reservas, no una fuente de verdad: se
/// borra y se reescribe entera en cada `reasignarReservas()`. Existe para que
/// la app del celular pueda verlo: `pedidos`, `reservas_stock` y `stock` tienen
/// RLS con cero policies, y la cuenta de quién espera se hace en TypeScript
/// resolviendo variantes y recetas de funda. Replicar eso en SQL sería tener
/// dos versiones de la lógica más delicada del ERP.
///
/// No son columnas de `Stock` a propósito: `@updatedAt` movería la marca de
/// agua que mira `reasignarSiElStockCambio` y el reparto se dispararía a sí
/// mismo para siempre.
model ProduccionPendiente {
  stockId       String   @id @map("stock_id")
  tenantId      String   @default("sendero3d") @map("tenant_id")
  unidades      Int // piezas que faltan para cubrir lo comprometido
  pedidos       Int // cuántos pedidos las están esperando
  actualizadoEn DateTime @default(now()) @map("actualizado_en")

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("produccion_pendiente")
}

/// Receta: qué insumo se consume cuando un item lleva ciertas variantes.
/// "Yamato Katana + Con Funda + 95cm consume 1 de `Funda Yamato 95cm`".
///
/// Existe porque la funda no abre fila de stock propia en la katana (no limita
/// la venta) pero sí sale de una pila que hay que reponer.
model ReglaInsumo {
  id       String   @id @default(cuid())
  tenantId String   @default("sendero3d") @map("tenant_id")
  modeloId String   @map("modelo_id")
  requiere String[] @default([]) // ids de VarianteModelo que deben estar TODAS
  stockId  String   @map("stock_id") // la unidad de stock del insumo
  cantidad Int      @default(1)
  creadoEn DateTime @default(now()) @map("creado_en")

  modelo Modelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  stock  Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([tenantId, modeloId])
  @@map("reglas_insumo")
}

/// Ventas de un negocio ajeno que comparte la cuenta de Mercado Libre.
///
/// Las publicaciones marcadas `ignorar` no generan pedido en el ERP —son de
/// Shay Juguetes— pero la plata entra a la misma cuenta y hay que pasársela.
/// Acá queda el cierre de cada mes: el total y el detalle pedido por pedido.
///
/// Se guarda calculado (y no se recalcula al vuelo) porque son ~5 llamadas a la
/// API de ML por mes: demasiado lento para hacerlo en cada carga de Finanzas.
model VentaTercero {
  id       String @id @default(cuid())
  tenantId String @default("sendero3d") @map("tenant_id")
  socio    String // "shayjuguetes"
  anio     Int
  mes      Int
  unidades Int    @default(0)
  bruto    Float  @default(0) // lo que pagó el comprador por el producto
  comision Float  @default(0) // lo que se llevó ML
  neto     Float  @default(0) // bruto - comisión
  pedidos  Json // detalle: una fila por item vendido

  // El otro lado de la misma cuenta: lo que vendió Sendero ese mes. Sale de la
  // misma pasada, y es lo que define en qué proporción se reparten los gastos
  // compartidos.
  unidadesPropias Int   @default(0) @map("unidades_propias")
  brutoPropio     Float @default(0) @map("bruto_propio")
  comisionPropia  Float @default(0) @map("comision_propia")
  netoPropio      Float @default(0) @map("neto_propio")

  // La publicidad se imputa directo, no se prorratea: se sabe de quién es cada
  // campaña. Ver `lib/ml-publicidad`.
  publicidad Float   @default(0)
  notas      String?

  calculadoEn DateTime @default(now()) @updatedAt @map("calculado_en")

  @@unique([tenantId, socio, anio, mes])
  @@map("ventas_terceros")
}

/// Gastos de la cuenta de Mercado Libre que no son de una tienda sola:
/// percepciones, convenio multilateral y monotributo.
///
/// Se cargan una vez por mes con el total, y cada tienda se hace cargo de la
/// parte que le toca según cuánto vendió (neto sobre neto). La publicidad NO
/// entra acá: esa se sabe de quién es, campaña por campaña.
model GastoCompartido {
  id           String   @id @default(cuid())
  tenantId     String   @default("sendero3d") @map("tenant_id")
  anio         Int
  mes          Int
  percepciones Float    @default(0)
  iibb         Float    @default(0) // convenio multilateral
  monotributo  Float    @default(0)
  notas        String?
  creadoEn     DateTime @default(now()) @map("creado_en")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, anio, mes])
  @@map("gastos_compartidos")
}

// ==================== COMBINACIONES VENDIBLES (docs/sdd/001) ====================

/// Lo que se vende: un modelo más las variantes que lo definen. Tiene SKU propio
/// (el del modelo + un sufijo por variante) y es a lo que apuntan las líneas de
/// pedido y el mapeo de cada canal. Tabla creada por prisma/sql/combinaciones.sql.
model Combinacion {
  id        String   @id @default(cuid())
  tenantId  String   @default("sendero3d") @map("tenant_id")
  modeloId  String   @map("modelo_id")
  /// ids de VarianteModelo, ordenados
  variantes String[] @default([])
  /// "<modeloId>|<variantes ordenadas, con coma>"
  clave     String
  /// Siempre en mayúsculas. null si el modelo no tiene SKU.
  sku       String?
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("updated_at")

  modelo Modelo       @relation(fields: [modeloId], references: [id])
  items  ItemPedido[]
  mapeos MapeoCanal[]

  @@unique([tenantId, clave])
  @@unique([tenantId, sku])
  @@index([tenantId, modeloId])
  @@map("combinaciones")
}

/// A qué combinación corresponde cada publicación de un canal (spec 004).
/// Sin combinación y sin `ignorar` = está en la cola de Integraciones › Mapeo.
model MapeoCanal {
  id              String    @id @default(cuid())
  tenantId        String    @default("sendero3d") @map("tenant_id")
  /// "mercadolibre" | "shop"
  canal           String
  /// ML: "<MLA>|<variation_id>". Shop: "<producto_id>|<opcion_ids>" o "sku:<SKU>|<opciones>".
  clave           String
  combinacionId   String?   @map("combinacion_id")
  /// Un "pack de 10" es 10 unidades de la combinación.
  unidades        Int       @default(1)
  /// Otro negocio (Shay): la línea se descarta, como publicaciones_ml.ignorar.
  ignorar         Boolean   @default(false)
  /// "siembra" | "auto" | "manual". Uno manual no lo pisa la resolución automática.
  origen          String    @default("auto")
  descripcion     String?
  /// Lo último que mandó el canal con esta clave (título, opciones).
  muestra         Json?
  vecesVista      Int       @default(0) @map("veces_vista")
  ultimaVenta     String?   @map("ultima_venta")
  /// Lo último que se leyó del canal (docs/sdd/003, spec 004). En ML, el precio standard.
  precioPublicado Float?    @map("precio_publicado")
  precioLeidoEn   DateTime? @map("precio_leido_en")
  /// Estado, promoción, automatización, variaciones: lo que decide si se puede tocar.
  precioLectura   Json?     @map("precio_lectura")
  creadoEn        DateTime  @default(now()) @map("creado_en")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  combinacion Combinacion? @relation(fields: [combinacionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, canal, clave])
  @@index([combinacionId])
  @@map("mapeos_canal")
}

/// Cada precio que el ERP aplicó, o intentó aplicar, en un canal (docs/sdd/003, spec 004, REQ-4).
model CambioPrecio {
  id            String   @id @default(cuid())
  tenantId      String   @default("sendero3d") @map("tenant_id")
  /// "mercadolibre" | "shop" | "erp"
  canal         String
  /// La de mapeos_canal. En "erp", el id del modelo o "variante:<id>".
  clave         String
  combinacionId String?  @map("combinacion_id")
  antes         Float?
  despues       Float
  /// "aplicado" | "rechazado" | "error"
  estado        String
  /// Lo que contestó el canal, o por qué no se mandó.
  respuesta     Json?
  usuario       String?
  creadoEn      DateTime @default(now()) @map("creado_en")

  @@index([tenantId, canal, clave, creadoEn])
  @@map("cambios_precio")
}

/// La última lectura de promos de una publicación de ML (docs/sdd/006, spec 010).
model PromoMlLectura {
  tenantId String   @map("tenant_id")
  mla      String
  /// PromoDePublicacion[] (src/lib/promos-ml-reglas.ts)
  promos   Json
  error    String?
  leidoEn  DateTime @default(now()) @map("leido_en")

  @@id([tenantId, mla])
  @@map("promos_ml_lectura")
}

/// Cada vez que se prende o apaga Flex desde el ERP (docs/sdd/006, spec 007).
model CambioFlex {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  mla       String
  antes     Boolean?
  despues   Boolean
  /// "aplicado" | "sin_efecto" | "error"
  estado    String
  respuesta Json?
  usuario   String?
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([tenantId, creadoEn])
  @@map("cambios_flex")
}

/// Cada promo de ML que se prende, cambia o saca desde el ERP (docs/sdd/006, spec 010, REQ-7).
model CambioPromo {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  mla           String
  combinacionId String?  @map("combinacion_id")
  /// "sumar" | "cambiar" | "sacar"
  accion        String
  promocionId   String?  @map("promocion_id")
  promocionTipo String   @map("promocion_tipo")
  antes         Json?
  despues       Json?
  /// "aplicado" | "sin_efecto" | "rechazado" | "error"
  estado        String
  respuesta     Json?
  usuario       String?
  creadoEn      DateTime @default(now()) @map("creado_en")

  @@index([tenantId, creadoEn])
  @@index([tenantId, mla, creadoEn])
  @@map("cambios_promos")
}

/// Cada cambio en Product Ads de ML, desde la página o desde Claude (docs/sdd/005, spec 002, REQ-4).
model CambioPublicidad {
  id         String   @id @default(cuid())
  tenantId   String   @default("sendero3d") @map("tenant_id")
  tipo       String // "campana" | "anuncio"
  objetivoId String   @map("objetivo_id")
  nombre     String?
  antes      Json?
  despues    Json
  estado     String // "aplicado" | "error"
  respuesta  Json?
  origen     String // "pantalla" | "claude"
  usuario    String?
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@index([tenantId, tipo, objetivoId, creadoEn])
  @@map("cambios_publicidad")
}

/// La configuración general de precios (docs/sdd/006, spec 001). Antes vivía en Bodega.
model ConfigPrecios {
  tenantId      String   @id @map("tenant_id")
  /// Las claves de GastosVenta (src/lib/precios-formula.ts) más "redondeo".
  gastos        Json
  actualizadoEn DateTime @default(now()) @map("actualizado_en")
  usuario       String?

  @@map("config_precios")
}

/// Cada cambio de la configuración de precios (docs/sdd/006, spec 001, REQ-3).
model CambioConfigPrecios {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  antes    Json?
  despues  Json
  usuario  String?
  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([tenantId, creadoEn])
  @@map("cambios_config_precios")
}
